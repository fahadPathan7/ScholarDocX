GLM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

TAVILY_API_KEY=
TAVILY_API_KEY_SCHOLARSHIP_HUNT=
# Brave Search API powers Scholarship Hunt deep search (SCHOLARDOCX-0175).
# Tavily above remains for /ai/research only.
BRAVE_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com/res/v1/web/search
# Research Expert vector embeddings (jina-embeddings-v4). Required for paper upload & analysis.
JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1/embeddings
SCHOLARDOCX_WORKSPACE=./workspace
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. When set, the backend uses this PostgreSQL connection (e.g. Supabase)
# instead of the local SQLite file. Leave empty to keep using local SQLite.
# NOTE: URL-encode any special chars in the password (# -> %23, * -> %2A, @ -> %40).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/chat/completions  # For GLM Coding Plan
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions  # For standard GLM API
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# JWT signing secret (cryptographic signature key)
# JWT_SECRET=your-secure-jwt-signing-secret-key-here

# Google OAuth sign-in (SCHOLARDOCX-0169). Optional — if CLIENT_ID and
# CLIENT_SECRET are unset, the "Sign in with Google" route returns 503.
# Create credentials at Google Cloud Console -> APIs & Services -> Credentials.
# GOOGLE_REDIRECT_URI must match a URI registered in the Console and points
# at the BACKEND callback route, not the frontend.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_ORIGIN=http://localhost:5173

