# Test database URL for the backend pytest suite (SCHOLARDOCX-0209).
#
# Copy this file to `.env.test` (it is gitignored). When `.env.test` exists,
# backend/tests/conftest.py loads it with override=True so this DATABASE_URL
# takes precedence over the production DATABASE_URL in `.env`.
#
# `make test-db-start` starts a matching Postgres + pgvector container.
#
# Tests never run on the live/Supabase database while this file is present.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/scholardocx_test
